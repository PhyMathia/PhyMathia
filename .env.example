# PhyMathia 环境变量模板
#
# 用法：复制本文件为 .env，然后填入自己的值。
#     cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 排除，**永远不要提交它**。本文件只写键名、不含任何真实密钥。
#
# 📌 全部键都是可选的：不配置任何一个也能完整体验——PhyMathia 内置了免费的兜底模型通道，
#    开箱即可用。填了密钥只是让你能用上更强的模型、或避免消耗免费额度。


# ====== 模型供应商密钥（按需填其一或多个）======

# 深度求索 DeepSeek：https://platform.deepseek.com
# 通用性价比最高，代码里作为多个通道的末位兜底。
DEEPSEEK_API_KEY=

# OpenCode Go 网关：https://opencode.go
# 代码优先读这个键；也兼容旧名 OPENCODE_API_KEY。
OPENCODE_GO_API_KEY=

# 智谱 GLM：https://open.bigmodel.cn
ZHIPU_API_KEY=


# ====== 可选功能开关（一般不用改）======

# 语义向量证据。设为 0 / off / false 关闭；本机若无向量模型文件会自动降级为纯词面口径。
# PHYMATHIA_EMBEDDING=0

# 概念提取的作用域。设为 same_session 时只在当前会话内做概念地基。
# PHYMATHIA_CONCEPT_SCOPE=same_session

# 公网访问口令。**默认为空 = 完全不启用**。只有当你把服务放到本机回环地址之外
# （如 Cloudflare 隧道、反向代理）时才需要设，否则任何拿到链接的人都能直接使用你的
# 服务、会消耗你的模型额度、并读写 data/ 下的数据。设了之后，非本机请求必须带口令。
# 填写时用随机字符串，不要用你别的账号的密码。
# PHYMathIA_SHARE_TOKEN=

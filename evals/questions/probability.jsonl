{"id": "prob-001", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：古典概型", "question": "同时掷两枚均匀骰子，点数之和恰好为 7 的概率是多少？", "expected_answer": ["1/6"], "answer_check": {"type": "numeric", "value": 0.1667, "tol": 0.002, "alt_values": [{"value": 16.67, "tol": 0.5}]}, "solution_path": "样本空间 6×6=36；和为 7 的组合 (1,6)(2,5)(3,4)(4,3)(5,2)(6,1) 共 6 个；P=6/36=1/6。", "key_steps": [{"point": "样本空间 36 个等可能结果", "evidence": ["36"]}, {"point": "数出有利样本 6 个", "evidence": ["共6", "6种", "6个"]}, {"point": "6/36 = 1/6", "evidence": ["\\frac{1}{6}", "1/6", "0.167", "16.7"]}], "common_errors": [{"wrong": "1/9", "desc": "把 (1,6) 与 (6,1) 当同一组合"}, {"wrong": "1/12", "desc": "有利样本或样本空间数错"}], "notes": "", "verify": {"mode": "value", "expr": "len([(a,b) for a in range(1,7) for b in range(1,7) if a+b==7])/36"}}
{"id": "prob-002", "domain": "probability", "kind": "solve", "difficulty": "medium", "topic": "考点：贝叶斯公式/基率", "question": "某疾病患病率 1%。检测灵敏度 95%（患病者 95% 呈阳性），假阳性率 5%（健康者 5% 呈阳性）。某人检测呈阳性，其真实患病概率是多少？", "expected_answer": ["约 0.161（16.1%）"], "answer_check": {"type": "numeric", "value": 0.161, "tol": 0.005, "alt_values": [{"value": 16.1, "tol": 1}]}, "solution_path": "贝叶斯：P(病|阳) = 0.01×0.95 / (0.01×0.95 + 0.99×0.05) = 0.0095/0.059 ≈ 0.161。", "key_steps": [{"point": "用全概率公式算分母", "evidence": ["0.0095", "0.059", "全概率"]}, {"point": "套贝叶斯/后验公式", "evidence": ["贝叶斯", "bayes", "后验"]}, {"point": "结论约 16.1%（远小于 95%）", "evidence": ["0.161", "0.16", "16.1"]}], "common_errors": [{"wrong": "0.95", "desc": "把灵敏度直接当后验（基率忽视）"}], "notes": "wrong 串 0.95 会与合法的贝叶斯分母撞车——已知警示噪音，known_wrong_echo 不参与判分所以无害。", "verify": {"mode": "value", "expr": "Rational(1,100)*Rational(95,100)/(Rational(1,100)*Rational(95,100)+Rational(99,100)*Rational(5,100))"}}
{"id": "prob-003", "domain": "probability", "kind": "error_catch", "difficulty": "medium", "topic": "考点：独立性/大数定律误用", "question": "请判断这个说法是否正确：「一枚均匀硬币连续抛出 10 次全是正面。根据大数定律，前 10 次正面太多了，为了『回归』一半，第 11 次抛出反面的概率应该大于 1/2。」", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误（赌徒谬误）。每次抛掷相互独立，第 11 次出反面的概率仍是 1/2。大数定律说的是长期频率趋近概率，不会『校正』短期偏差。", "key_steps": [{"point": "指出各次抛掷独立，第 11 次仍是 1/2", "evidence": ["独立", "无关", "仍是", "依然是"]}, {"point": "指出大数定律不能这样用", "evidence": ["大数定律", "赌徒谬误", "不能这样用", "长期", "短期"]}], "common_errors": [{"wrong": "大于1/2", "desc": "赌徒谬误：以为随机过程会自我校正"}], "notes": ""}
{"id": "prob-004", "domain": "probability", "kind": "solve", "difficulty": "medium", "topic": "考点：正态分布标准化", "question": "设 X ~ N(2, 9)（第二个参数是方差），求 P(X > 5)。已知 Φ(1) = 0.8413。", "expected_answer": ["0.1587"], "answer_check": {"type": "numeric", "value": 0.1587, "tol": 0.002, "alt_values": [{"value": 15.87, "tol": 0.5}]}, "solution_path": "σ=√9=3；Z=(5−2)/3=1；P(X>5)=1−Φ(1)=0.1587。", "key_steps": [{"point": "σ 取标准差 3 而非方差 9", "evidence": ["σ=3", "\\sigma=3", "开方", "平方根"]}, {"point": "标准化 Z=(5−2)/3=1", "evidence": ["(5-2)/3", "(5−2)/3", "z=1"]}, {"point": "1−Φ(1)=0.1587", "evidence": ["0.1587", "1-0.8413", "1−0.8413", "0.159"]}], "common_errors": [{"wrong": "0.3694", "desc": "误用 σ=9 标准化（Z=1/3，1−Φ(1/3)≈0.369）"}, {"wrong": "=0.8413", "desc": "忘了 1−Φ，直接把 Φ(1) 当答案"}], "notes": "", "verify": {"mode": "value", "expr": "float(P(Normal('X',2,3) > 5))"}}
{"id": "prob-005", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：古典概型（骰子点数和）", "question": "同时掷两枚均匀骰子，点数之和恰好为 8 的概率是多少？", "expected_answer": ["5/36 ≈ 0.1389"], "answer_check": {"type": "numeric", "value": 0.1389, "tol": 0.003}, "solution_path": "样本空间 36；和为 8 的组合 (2,6)(3,5)(4,4)(5,3)(6,2) 共 5 个；P=5/36≈0.1389。", "key_steps": [{"point": "样本空间 36", "evidence": ["36"]}, {"point": "数出有利样本 5 个", "evidence": ["共5", "5种", "5个", "共5种"]}, {"point": "P=5/36", "evidence": ["5/36", "0.139", "0.138", "\\frac{5}{36}"]}], "common_errors": [{"wrong": "1/6", "desc": "照搬「和为 7」的组合数 6"}, {"wrong": "1/9", "desc": "把 (4,4) 当作与 (4,4) 可交换而多去重，得 4/36"}], "verify": {"mode": "value", "expr": "len([(a,b) for a in range(1,7) for b in range(1,7) if a+b==8])/36"}}
{"id": "prob-006", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：超几何/组合计数", "question": "一批产品 10 件，其中 3 件次品。从中任取 2 件，两件都是正品的概率是多少？", "expected_answer": ["7/15 ≈ 0.4667"], "answer_check": {"type": "numeric", "value": 0.4667, "tol": 0.005}, "solution_path": "正品 7 件：P=C(7,2)/C(10,2)=21/45=7/15≈0.4667。", "key_steps": [{"point": "正品 7 件、取 2 件", "evidence": ["c(7,2)", "7件", "组合"]}, {"point": "C(7,2)=21、C(10,2)=45", "evidence": ["21", "45"]}, {"point": "P=21/45=7/15", "evidence": ["21/45", "7/15", "0.467", "0.466"]}], "common_errors": [{"wrong": "1/15", "desc": "算成两件都是次品的概率"}, {"wrong": "0.3", "desc": "用次品率 3/10 乱乘"}], "verify": {"mode": "value", "expr": "float(Rational(binomial(7,2), binomial(10,2)))"}}
{"id": "prob-007", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：互斥事件加法公式", "question": "A、B 互斥，P(A)=0.3，P(B)=0.5。求 P(A∪B)。", "expected_answer": ["0.8"], "answer_check": {"type": "numeric", "value": 0.8, "tol": 0.005}, "solution_path": "互斥时 P(A∩B)=0：P(A∪B)=0.3+0.5=0.8。", "key_steps": [{"point": "互斥 ⇒ 交集概率为 0", "evidence": ["互斥", "交集", "p(a∩b)=0", "不相容"]}, {"point": "直接相加 0.3+0.5", "evidence": ["0.3+0.5", "相加"]}, {"point": "P(A∪B)=0.8", "evidence": ["0.8"]}], "common_errors": [{"wrong": "0.15", "desc": "误当独立事件相乘"}, {"wrong": "直接相乘", "desc": "互斥与独立混淆，乘出 0.15"}], "verify": {"mode": "value", "expr": "float(Rational(3,10) + Rational(5,10))"}}
{"id": "prob-008", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：条件概率（缩小样本空间）", "question": "掷一枚均匀骰子，已知掷出的是偶数。在这个条件下，点数大于 4 的概率是多少？", "expected_answer": ["1/3"], "answer_check": {"type": "numeric", "value": 0.3333, "tol": 0.005}, "solution_path": "条件样本空间 {2,4,6} 共 3 个；其中大于 4 的只有 {6}；P=1/3。", "key_steps": [{"point": "缩小样本空间到偶数 {2,4,6}", "evidence": ["{2,4,6}", "偶数", "缩小"]}, {"point": "其中满足的是 {6} 一个", "evidence": ["{6}", "只有6", "一个", "1个"]}, {"point": "P=1/3", "evidence": ["1/3", "0.333", "0.33", "\\frac{1}{3}"]}], "common_errors": [{"wrong": "1/2", "desc": "没条件化，用 {5,6}/6"}, {"wrong": "1/6", "desc": "忘了缩小样本空间，仍按 6 个算"}], "verify": {"mode": "value", "expr": "len([x for x in [1,2,3,4,5,6] if x%2==0 and x>4]) / len([x for x in [1,2,3,4,5,6] if x%2==0])"}}
{"id": "prob-009", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：离散均匀分布期望", "question": "掷一枚均匀骰子，点数 X 的期望 E(X) 是多少？", "expected_answer": ["3.5"], "answer_check": {"type": "numeric", "value": 3.5, "tol": 0.01}, "solution_path": "E(X)=(1+2+3+4+5+6)/6=21/6=3.5。", "key_steps": [{"point": "加权平均（每点 1/6）", "evidence": ["加权", "平均", "1/6", "\\frac{1}{6}"]}, {"point": "求和 21 除以 6", "evidence": ["21/6", "21", "(1+2+3+4+5+6)"]}, {"point": "E(X)=3.5", "evidence": ["3.5", "e(x)=3.5"]}], "common_errors": [{"wrong": "期望是3", "desc": "取中间某个值当期望（没做加权平均）"}, {"wrong": "期望为6", "desc": "把最大可能点数当期望"}], "verify": {"mode": "value", "expr": "float(sum(range(1,7))/6)"}}
{"id": "prob-010", "domain": "probability", "kind": "solve", "difficulty": "medium", "topic": "考点：二项分布恰好 k 次", "question": "独立射击 5 次，每次命中率 0.6。恰好命中 3 次的概率是多少？", "expected_answer": ["0.3456"], "answer_check": {"type": "numeric", "value": 0.3456, "tol": 0.002}, "solution_path": "二项分布：P=C(5,3)·0.6³·0.4²=10·0.216·0.16=0.3456。", "key_steps": [{"point": "二项分布公式 C(n,k)p^k(1−p)^{n−k}", "evidence": ["二项分布", "c(5,3)", "组合数", "p^k", "0.6³", "0.6^3"]}, {"point": "C(5,3)=10", "evidence": ["c(5,3)=10", "=10", "组合数10"]}, {"point": "P=0.3456", "evidence": ["0.3456", "0.346", "0.345"]}], "common_errors": [{"wrong": "0.216", "desc": "忘了组合数 C(5,3)=10，只算 0.6³"}, {"wrong": "概率是0.6", "desc": "把单次命中率当答案"}], "verify": {"mode": "value", "expr": "float(10 * Rational(6,10)**3 * Rational(4,10)**2)"}}
{"id": "prob-011", "domain": "probability", "kind": "solve", "difficulty": "medium", "topic": "考点：泊松分布", "question": "某电话台每小时接到呼叫次数服从泊松分布，平均 λ=2 次/小时。求一小时内一次呼叫都没有（X=0）的概率（保留四位小数）。", "expected_answer": ["e⁻² ≈ 0.1353"], "answer_check": {"type": "numeric", "value": 0.1353, "tol": 0.002}, "solution_path": "泊松分布 P(X=k)=λᵏe^{−λ}/k!；P(X=0)=e^{−2}≈0.1353。", "key_steps": [{"point": "泊松公式 λᵏe^{−λ}/k!", "evidence": ["泊松", "λᵏ", "λ^k", "e^{-λ}", "e^{−λ}"]}, {"point": "k=0 时只剩 e^{−λ}", "evidence": ["k=0", "e^{-2}", "e^{−2}"]}, {"point": "≈0.1353", "evidence": ["0.1353", "0.135"]}], "common_errors": [{"wrong": "把λ当概率", "desc": "把平均次数 λ=2 当成概率"}, {"wrong": "0.2707", "desc": "算成 P(X=1)=λe^{−λ}"}], "verify": {"mode": "value", "expr": "float(exp(-2))"}}
{"id": "prob-012", "domain": "probability", "kind": "solve", "difficulty": "medium", "topic": "考点：几何分布（首次成功）", "question": "每次试验成功概率 0.4，独立重复进行。第 3 次试验才首次成功的概率是多少？", "expected_answer": ["0.144"], "answer_check": {"type": "numeric", "value": 0.144, "tol": 0.002}, "solution_path": "几何分布：前两次失败、第三次成功：0.6²·0.4=0.36·0.4=0.144。", "key_steps": [{"point": "几何分布（1−p）^{k−1}·p", "evidence": ["几何分布", "(1−p)^{k−1}", "(1-p)^{k-1}", "首次成功"]}, {"point": "0.6²·0.4", "evidence": ["0.6²", "0.6^2", "0.36"]}, {"point": "P=0.144", "evidence": ["0.144"]}], "common_errors": [{"wrong": "0.4", "desc": "把单次成功概率当答案"}, {"wrong": "0.24", "desc": "只乘了一次 0.6（漏了 k−1=2 次）"}], "verify": {"mode": "value", "expr": "float(Rational(6,10)**2 * Rational(4,10))"}}
{"id": "prob-013", "domain": "probability", "kind": "error_catch", "difficulty": "basic", "topic": "考点：加法公式与交集", "question": "请判断下面解法是否正确，若错误请给出正确公式：「对任意两事件 A、B：P(A∪B)=P(A)+P(B)。概率就是相加。」", "expected_answer": [], "answer_check": {}, "solution_path": "解法错误。一般加法公式是 P(A∪B)=P(A)+P(B)−P(A∩B)，交集被算了两次要扣掉；只有互斥（P(A∩B)=0）时才能直接相加。", "key_steps": [{"point": "指出要减去 P(A∩B)", "evidence": ["减去", "交集", "p(a∩b)", "多算了"]}, {"point": "说明互斥时才可直接相加", "evidence": ["互斥", "不相容", "才能直接"]}], "common_errors": [{"wrong": "直接相加", "desc": "把互斥情形的公式当一般公式"}]}
{"id": "prob-014", "domain": "probability", "kind": "error_catch", "difficulty": "medium", "topic": "考点：互斥与独立的混淆", "question": "请判断下面说法是否正确，若错误请说明：「A、B 互斥说明它们互不干扰，所以互斥的两个事件一定相互独立。」", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。互斥是 P(A∩B)=0（不能同时发生）；独立是 P(A∩B)=P(A)P(B)。正概率互斥事件恰好不独立：P(A)P(B)>0≠0=P(A∩B)。互斥反而「高度相关」（一个发生另一个必不发生）。", "key_steps": [{"point": "区分互斥（交集空）与独立（概率乘法）", "evidence": ["p(a∩b)=0", "p(a)p(b)", "交集空", "乘法"]}, {"point": "指出正概率互斥必不独立", "evidence": ["不独立", "必不独立", "反而相关", "高度相关"]}], "common_errors": [{"wrong": "一定相互独立", "desc": "把「不能同时发生」误读成「互不影响」"}]}
{"id": "prob-015", "domain": "probability", "kind": "error_catch", "difficulty": "medium", "topic": "考点：期望的含义", "question": "请判断下面说法是否正确，若错误请说明：「期望就是最可能出现的值，所以掷骰子的期望应该是 1 或 6 之一。」", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。期望是按概率加权的长期平均值，不是最可能的值：E=（1+…+6)/6=3.5，而 3.5 根本不是可能的结果。众数才是最可能的值（骰子场合每个点数等可能）。", "key_steps": [{"point": "指出期望是概率加权平均", "evidence": ["加权平均", "平均值", "长期平均", "平均"]}, {"point": "用骰子反例：期望 3.5 不是可能取值", "evidence": ["3.5", "不是可能", "取不到", "不可能出现"]}, {"point": "指出「最可能」对应众数", "evidence": ["众数", "最可能"]}], "common_errors": [{"wrong": "期望是最可能值", "desc": "把期望与众数混淆"}]}
{"id": "prob-016", "domain": "probability", "kind": "concept", "difficulty": "basic", "topic": "探针：小概率事件", "question": "有同学说：「概率 0.001 的事件在一次试验中不可能发生，因为概率太小了。」这个说法对吗？请说明。", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。只要概率不为 0，一次试验中就可能发生；0.001 意味着平均每 1000 次发生 1 次，单次试验结果不确定。「实际推断原理」只是说小概率事件在一次试验中不太可能发生、实践中可暂不考虑，不是逻辑上的不可能。", "key_steps": [{"point": "指出小概率≠不可能，单次仍可能发生", "evidence": ["仍可能", "可能发生", "不等于不可能", "不是不可能"]}, {"point": "解释 0.001 的频率含义（千分之一）", "evidence": ["1000", "千分之一", "千次", "频率"]}, {"point": "区分「实际推断原理」与逻辑不可能", "evidence": ["实际推断", "不太可能", "实践中", "逻辑上"]}], "common_errors": [{"wrong": "不可能发生", "desc": "把小概率误当成零概率"}]}
{"id": "prob-017", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：离散方差", "question": "X 等可能地取 −2 与 2。求 Var(X)。", "expected_answer": ["4"], "answer_check": {"type": "numeric", "value": 4, "tol": 0.01}, "solution_path": "E(X)=0；Var=E[(X−0)²]=(4+4)/2=4。", "key_steps": [{"point": "期望 E(X)=0（对称）", "evidence": ["e(x)=0", "e=0", "对称"]}, {"point": "偏差平方的平均 (4+4)/2", "evidence": ["(4+4)/2", "偏差平方", "平方的平均"]}, {"point": "Var=4", "evidence": ["方差=4", "var=4", "为4"]}], "common_errors": [{"wrong": "取值绝对值2", "desc": "没平方，把 2 当方差"}, {"wrong": "方差为0", "desc": "以为期望为 0 则方差为 0"}], "verify": {"mode": "value", "expr": "float(Rational((-2)**2 + 2**2, 2))"}}
{"id": "prob-018", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：全概率公式", "question": "甲盒装 3 红 2 白，乙盒装 1 红 4 白。先等可能任选一盒，再从该盒任取一球。取到红球的概率是多少？", "expected_answer": ["0.4"], "answer_check": {"type": "numeric", "value": 0.4, "tol": 0.005}, "solution_path": "全概率：P=1/2·(3/5)+1/2·(1/5)=3/10+1/10=0.4。", "key_steps": [{"point": "按盒子分解（全概率公式）", "evidence": ["全概率", "分解", "按盒"]}, {"point": "1/2·3/5 与 1/2·1/5 相加", "evidence": ["3/10", "1/10", "0.3+0.1", "0.3＋0.1"]}, {"point": "P=0.4", "evidence": ["=0.4", "0.4"]}], "common_errors": [{"wrong": "0.6", "desc": "只算了甲盒取红球的概率"}, {"wrong": "概率为0.5", "desc": "把「选盒子」的 0.5 当成答案"}], "verify": {"mode": "value", "expr": "float(Rational(1,2)*Rational(3,5) + Rational(1,2)*Rational(1,5))"}}
{"id": "prob-019", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：独立变量方差的加性", "question": "X、Y 相互独立，Var(X)=2，Var(Y)=3。求 Var(X+Y)。", "expected_answer": ["5"], "answer_check": {"type": "numeric", "value": 5, "tol": 0.01}, "solution_path": "独立时方差可加：Var(X+Y)=Var(X)+Var(Y)=2+3=5。", "key_steps": [{"point": "独立 ⇒ 方差相加（无协方差项）", "evidence": ["独立", "相加", "协方差为0", "协方差"]}, {"point": "2+3=5", "evidence": ["2+3", "=5", "得5"]}], "common_errors": [{"wrong": "根号6", "desc": "把标准差思路混入（√2·√3）"}, {"wrong": "方差为1", "desc": "把方差当可减，算 3−2"}], "verify": {"mode": "value", "expr": "float(2 + 3)"}}
{"id": "prob-020", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：均匀分布区间概率", "question": "X 服从区间 (0,10) 上的均匀分布。求 P(2<X<5)。", "expected_answer": ["0.3"], "answer_check": {"type": "numeric", "value": 0.3, "tol": 0.005}, "solution_path": "均匀分布概率=长度比：(5−2)/10=3/10=0.3。", "key_steps": [{"point": "密度 1/10、概率＝长度比", "evidence": ["长度比", "均匀", "1/10"]}, {"point": "(5−2)/10", "evidence": ["(5−2)/10", "(5-2)/10", "3/10"]}, {"point": "P=0.3", "evidence": ["=0.3", "0.3"]}], "common_errors": [{"wrong": "概率为0.5", "desc": "把区间长度 3 与一半混淆"}, {"wrong": "概率为0.03", "desc": "小数点错位（把 3/100 当 3/10）"}], "verify": {"mode": "value", "expr": "float(Rational(5-2, 10))"}}
{"id": "prob-021", "domain": "probability", "kind": "solve", "difficulty": "medium", "topic": "考点：二项分布期望与方差", "question": "X~B(10, 0.3)。求 E(X) 与 Var(X)。", "expected_answer": ["E=3，Var=2.1"], "answer_check": {"type": "numeric", "mode": "all", "values": [3, 2.1], "tol": 0.02}, "solution_path": "E(X)=np=10·0.3=3；Var(X)=np(1−p)=10·0.3·0.7=2.1。", "key_steps": [{"point": "E=np", "evidence": ["e=np", "np", "期望=3", "e=3"]}, {"point": "Var=np(1−p)", "evidence": ["np(1−p)", "np(1-p)", "npq"]}, {"point": "E=3、Var=2.1", "evidence": ["2.1", "e=3", "期望3"]}], "common_errors": [{"wrong": "期望10", "desc": "把试验次数 n 当期望"}, {"wrong": "期望0.3", "desc": "把 p 当期望"}], "verify": {"mode": "value", "expr": "[float(10*Rational(3,10)), float(10*Rational(3,10)*Rational(7,10))]"}}
{"id": "prob-022", "domain": "probability", "kind": "solve", "difficulty": "hard", "topic": "考点：切比雪夫不等式", "question": "已知 E(X)=1000，Var(X)=2500。用切比雪夫不等式估计 P(|X−1000|≥300) 的上界。", "expected_answer": ["1/36 ≈ 0.0278"], "answer_check": {"type": "numeric", "value": 0.0278, "tol": 0.002}, "solution_path": "切比雪夫：P(|X−E|≥kσ 或 ε)≤Var/ε²＝2500/300²=2500/90000=1/36≈0.0278（k=300/50=6，上界 1/k²）。", "key_steps": [{"point": "套切比雪夫 P(|X−E|≥ε)≤Var/ε²", "evidence": ["切比雪夫", "var/ε²", "var/ε^2", "ε²", "ε^2"]}, {"point": "2500/300²=1/36", "evidence": ["2500/90000", "2500/300²", "2500/300^2", "1/36"]}, {"point": "上界 ≈0.0278", "evidence": ["0.0278", "0.028"]}], "common_errors": [{"wrong": "0.167", "desc": "用 k=6 后忘了平方（1/6 而非 1/36）"}, {"wrong": "上界1", "desc": "没代数值，只写不等式本身"}], "verify": {"mode": "value", "expr": "float(Rational(2500, 300**2))"}}
{"id": "prob-023", "domain": "probability", "kind": "solve", "difficulty": "medium", "topic": "考点：贝叶斯公式（复查版）", "question": "某病患病率 2%。检测灵敏度 90%（患病者 90% 阳性），健康者 8% 呈阳性（假阳性率）。某人检测阳性，其真实患病概率是多少？", "expected_answer": ["≈ 0.187"], "answer_check": {"type": "numeric", "value": 0.1867, "tol": 0.005}, "solution_path": "贝叶斯：P(病|阳)=(0.02·0.9)/(0.02·0.9+0.98·0.08)=0.018/0.0964≈0.187。", "key_steps": [{"point": "分母全概率 0.018+0.0784", "evidence": ["0.018", "0.0784", "0.0964", "全概率"]}, {"point": "贝叶斯作比", "evidence": ["贝叶斯", "后验", "作比"]}, {"point": "≈0.187（18.7%）", "evidence": ["0.187", "0.186", "18.7"]}], "common_errors": [{"wrong": "0.9", "desc": "把灵敏度直接当后验（基率忽视）"}, {"wrong": "0.08", "desc": "把假阳性率当后验"}], "verify": {"mode": "value", "expr": "float(Rational(2,100)*Rational(9,10) / (Rational(2,100)*Rational(9,10) + Rational(98,100)*Rational(8,100)))"}}
{"id": "prob-024", "domain": "probability", "kind": "solve", "difficulty": "hard", "topic": "考点：最大值分布与期望", "question": "掷两枚均匀骰子，记 M 为两者点数中的较大者。求 E(M)（保留三位小数）。", "expected_answer": ["161/36 ≈ 4.472"], "answer_check": {"type": "numeric", "value": 4.472, "tol": 0.005}, "solution_path": "枚举：Σmax(a,b)=1·1+2·3+3·5+4·7+5·9+6·11=161（max=k 的格数依次 1,3,5,7,9,11）；E(M)=161/36≈4.472。", "key_steps": [{"point": "max=k 的样本数 2k−1（1,3,5,7,9,11）", "evidence": ["1,3,5,7,9,11", "2k−1", "2k-1", "奇数个"]}, {"point": "求和 161", "evidence": ["161", "1+6+15+28+45+66"]}, {"point": "E=161/36≈4.472", "evidence": ["161/36", "4.472", "4.47"]}], "common_errors": [{"wrong": "3.5", "desc": "把单个骰子的期望当 max 的期望"}, {"wrong": "期望6", "desc": "把最大可能值 6 当期望"}], "verify": {"mode": "value", "expr": "sum(max(a,b) for a in range(1,7) for b in range(1,7))/36"}}
{"id": "prob-025", "domain": "probability", "kind": "solve", "difficulty": "hard", "topic": "考点：指数分布无记忆性", "question": "某元件寿命 T~Exp(λ=0.5)（小时）。已知它已正常工作 10 小时，求它再工作至少 6 小时的条件概率（保留四位小数）。", "expected_answer": ["e⁻³ ≈ 0.0498"], "answer_check": {"type": "numeric", "value": 0.0498, "tol": 0.002}, "solution_path": "指数分布无记忆：P(T>16|T>10)=P(T>6)=e^{−0.5·6}=e^{−3}≈0.0498。", "key_steps": [{"point": "用无记忆性把条件化为 P(T>6)", "evidence": ["无记忆", "条件化为", "p(t>6)", "p(t>6)"]}, {"point": "e^{−λt}=e^{−3}", "evidence": ["e^{-3}", "e^{−3}", "e^{-λt}"]}, {"point": "≈0.0498", "evidence": ["0.0498", "0.049", "0.05"]}], "common_errors": [{"wrong": "0.0003", "desc": "把已工作的 10 小时也乘进去（e^{−8}），没用无记忆性"}, {"wrong": "概率0.5", "desc": "把 λ 当概率"}], "verify": {"mode": "value", "expr": "float(exp(-Rational(1,2)*6))"}}
{"id": "prob-026", "domain": "probability", "kind": "error_catch", "difficulty": "medium", "topic": "考点：方差加法需要独立性", "question": "请判断下面解法是否正确，若错误请给出正确公式：「对任意随机变量 X、Y：Var(X+Y)=Var(X)+Var(Y)。方差是散布程度，直接相加即可。」", "expected_answer": [], "answer_check": {}, "solution_path": "解法错误。一般公式是 Var(X+Y)=Var(X)+Var(Y)+2Cov(X,Y)；只有 X、Y 不相关（协方差为 0，独立是其充分条件）时才能直接相加。正相关的两变量之和方差会更大。", "key_steps": [{"point": "指出一般要加 2Cov(X,Y) 项", "evidence": ["2cov", "协方差", "cov(x,y)", "cov项"]}, {"point": "说明独立/不相关时才可加", "evidence": ["独立", "不相关", "协方差为0", "协方差为0"]}], "common_errors": [{"wrong": "直接相加", "desc": "把独立情形的公式当一般公式"}]}
{"id": "prob-027", "domain": "probability", "kind": "error_catch", "difficulty": "hard", "topic": "考点：中心极限定理说的是什么", "question": "请判断下面说法是否正确，若错误请说明：「中心极限定理说任何随机变量都近似服从正态分布，所以只要样本量够大，单个观测值也一定是正态的。」", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。中心极限定理说的是：独立同分布、方差有限的条件下，大量样本的「样本均值（标准化后）」的分布趋近正态，不是任何随机变量本身正态。单个观测值的分布由总体决定（可以是均匀、指数等，样本再大也不变）。", "key_steps": [{"point": "指出定理对象是样本均值（标准化和）", "evidence": ["样本均值", "标准化", "均值", "和的分布"]}, {"point": "指出总体分布不随样本量改变", "evidence": ["总体", "不变", "单个观测", "单个观测值"]}, {"point": "指出条件：独立同分布、方差有限", "evidence": ["独立同分布", "方差有限", "条件"]}], "common_errors": [{"wrong": "任何随机变量", "desc": "把「均值趋近正态」扩大成「任何变量正态」"}]}
{"id": "prob-028", "domain": "probability", "kind": "concept", "difficulty": "medium", "topic": "探针：不相关与独立", "question": "有同学说：「相关系数 ρ=0 就说明 X 与 Y 相互独立，因为没有线性关系就没有任何关系。」这个说法对吗？请说明并给出反例（若有）。", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。ρ=0（不相关）只排除线性关系；独立⇒不相关，反之不成立。反例：X~U(−1,1)，Y=X²：Cov(X,Y)=E(X³)−E(X)E(X²)=0−0=0，但 Y 完全由 X 决定，强依赖、不独立。", "key_steps": [{"point": "指出不相关只排除线性关系，独立更强", "evidence": ["线性", "更强", "不等于独立", "推不出"]}, {"point": "给出反例 Y=X²", "evidence": ["x²", "x^2", "y=x²", "y=x^2"]}, {"point": "验证 Cov=0 但强依赖", "evidence": ["cov=0", "cov(x,y)=0", "e(x³)=0", "e(x^3)=0", "完全由"]}], "common_errors": [{"wrong": "就是独立", "desc": "把「无线性关系」当成「无任何关系」"}]}
{"id": "prob-029", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：正态分布对称性", "question": "X~N(3, 4)（第二个参数是方差）。求 P(X<3)。", "expected_answer": ["0.5"], "answer_check": {"type": "numeric", "value": 0.5, "tol": 0.005}, "solution_path": "正态分布关于均值 μ=3 对称，P(X<μ)=0.5。", "key_steps": [{"point": "正态关于均值对称", "evidence": ["对称", "关于μ", "关于均值", "均值"]}, {"point": "P(X<μ)=0.5", "evidence": ["0.5", "p(x<μ)=0.5", "一半"]}], "common_errors": [{"wrong": "0.8413", "desc": "乱套 Φ 值（忘了在对称中心）"}, {"wrong": "概率0.3", "desc": "把均值 3 当概率"}], "verify": {"mode": "value", "expr": "float(Rational(1,2))"}}
{"id": "prob-030", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：乘法公式", "question": "P(A)=0.4，P(B|A)=0.5。求 P(AB)。", "expected_answer": ["0.2"], "answer_check": {"type": "numeric", "value": 0.2, "tol": 0.005}, "solution_path": "乘法公式：P(AB)=P(A)·P(B|A)=0.4·0.5=0.2。", "key_steps": [{"point": "乘法公式 P(AB)=P(A)P(B|A)", "evidence": ["乘法公式", "p(a)p(b|a)", "p(ab)"]}, {"point": "0.4·0.5=0.2", "evidence": ["0.2", "0.20"]}], "common_errors": [{"wrong": "0.9", "desc": "把条件概率当成可加，0.4+0.5"}, {"wrong": "0.45", "desc": "先错误地把两者平均再算"}], "verify": {"mode": "value", "expr": "float(Rational(4,10)*Rational(5,10))"}}
{"id": "prob-031", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：抽签原理（公平性）", "question": "10 张签中有 3 张有奖。甲先抽、乙后抽（抽后不放回）。乙抽到奖签的概率是多少？", "expected_answer": ["3/10 = 0.3"], "answer_check": {"type": "numeric", "value": 0.3, "tol": 0.005}, "solution_path": "抽签公平：后抽与先抽中奖概率相同，都是 3/10。（全概率验证：1/10·3/9+9/10·? 展开= 3/10·(9/9)… 正确展开为 P=0.3）", "key_steps": [{"point": "抽签与顺序无关（公平性）", "evidence": ["公平", "顺序无关", "与顺序"]}, {"point": "概率 3/10", "evidence": ["3/10", "0.3", "\\frac{3}{10}"]}], "common_errors": [{"wrong": "0.7", "desc": "算成不中奖的概率"}, {"wrong": "0.1", "desc": "把 1/10（个位签）当概率"}], "verify": {"mode": "value", "expr": "float(Rational(3,10))"}}
{"id": "prob-032", "domain": "probability", "kind": "solve", "difficulty": "medium", "topic": "考点：全期望公式", "question": "某批设备 80% 出自状态好的产线（平均寿命 10 年），20% 出自状态差的产线（平均寿命 4 年）。随机取一台，其平均寿命期望是多少年？", "expected_answer": ["8.8 年"], "answer_check": {"type": "numeric", "value": 8.8, "tol": 0.02}, "solution_path": "全期望：E=0.8·10+0.2·4=8+0.8=8.8 年。", "key_steps": [{"point": "全期望（按产线分解加权）", "evidence": ["全期望", "加权", "分解"]}, {"point": "0.8·10+0.2·4", "evidence": ["8+0.8", "8.8", "加权平均"]}, {"point": "E=8.8 年", "evidence": ["8.8", "=8.8"]}], "common_errors": [{"wrong": "7", "desc": "简单算术平均 (10+4)/2"}, {"wrong": "寿命10", "desc": "只算了好产线（忽略 20%）"}], "verify": {"mode": "value", "expr": "float(Rational(8,10)*10 + Rational(2,10)*4)"}}
{"id": "prob-033", "domain": "probability", "kind": "solve", "difficulty": "basic", "topic": "考点：对立事件（至少一次）", "question": "掷一枚均匀硬币 3 次，至少出现一次正面的概率是多少？", "expected_answer": ["7/8 = 0.875"], "answer_check": {"type": "numeric", "value": 0.875, "tol": 0.005}, "solution_path": "用对立事件：P(至少一次正面)=1−P(全反面)=1−(1/2)³=1−1/8=7/8=0.875。", "key_steps": [{"point": "取对立事件「全反面」", "evidence": ["对立", "全反面", "反面"]}, {"point": "1−(1/2)³", "evidence": ["1−(1/2)³", "1-(1/2)^3", "1−1/8", "1-1/8"]}, {"point": "P=7/8", "evidence": ["7/8", "0.875", "\\frac{7}{8}"]}], "common_errors": [{"wrong": "0.5", "desc": "把单次概率当答案"}, {"wrong": "0.125", "desc": "忘了取对立（算成全反面的概率）"}], "verify": {"mode": "value", "expr": "float(1 - Rational(1,2)**3)"}}
{"id": "prob-034", "domain": "probability", "kind": "solve", "difficulty": "hard", "topic": "考点：协方差计算", "question": "(X,Y) 联合分布：P(0,0)=0.3，P(0,1)=0.2，P(1,0)=0.2，P(1,1)=0.3。求 Cov(X,Y)。", "expected_answer": ["0.05"], "answer_check": {"type": "numeric", "value": 0.05, "tol": 0.005}, "solution_path": "E(X)=0.5，E(Y)=0.5；E(XY)=1·P(1,1)=0.3；Cov=0.3−0.5·0.5=0.3−0.25=0.05。", "key_steps": [{"point": "边缘期望 E(X)=E(Y)=0.5", "evidence": ["e(x)=0.5", "e(y)=0.5", "0.5", "边缘"]}, {"point": "E(XY)=0.3", "evidence": ["e(xy)=0.3", "e(xy)＝0.3"]}, {"point": "Cov=0.3−0.25=0.05", "evidence": ["0.3−0.25", "0.3-0.25", "cov=0.05", "0.05"]}], "common_errors": [{"wrong": "cov是0", "desc": "以为对称分布就独立（协方差为 0）"}, {"wrong": "cov是0.3", "desc": "把 E(XY) 直接当协方差，忘了减乘积期望"}], "verify": {"mode": "value", "expr": "float(Rational(3,10) - Rational(1,2)*Rational(1,2))"}}
{"id": "prob-035", "domain": "probability", "kind": "error_catch", "difficulty": "medium", "topic": "考点：条件概率不可交换", "question": "请判断下面说法是否正确，若错误请说明：「P(A|B) 与 P(B|A) 是一回事，条件谁在前谁在后没关系。」", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。P(A|B)=P(AB)/P(B)、P(B|A)=P(AB)/P(A)，分母不同一般不等。医疗检测就是典型：P(阳性|病)=灵敏度（高），P(病|阳性)=后验（可能很低）。两者由贝叶斯公式联系。", "key_steps": [{"point": "指出两者分母不同", "evidence": ["分母", "p(b)", "p(a)", "除以"]}, {"point": "举检测例或贝叶斯联系", "evidence": ["贝叶斯", "灵敏度", "后验", "医疗"]}], "common_errors": [{"wrong": "一回事", "desc": "把条件方向当成无关紧要"}]}
{"id": "prob-036", "domain": "probability", "kind": "error_catch", "difficulty": "medium", "topic": "考点：对立事件的定义", "question": "请判断下面说法是否正确，若错误请说明：「只要 P(A)+P(B)=1，A 与 B 就是对立事件。」", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。对立要求 A∩B=∅ 且 A∪B=Ω（互斥且并集为全空间）。P(A)+P(B)=1 在两者有重叠时不成立对立：例如 P(A)=0.6、P(B)=0.4 且 P(AB)=0.1，概率和为 1 但有交集。", "key_steps": [{"point": "指出还需互斥（交集为空）且并为全空间", "evidence": ["互斥", "交集为空", "并集", "全空间", "∅"]}, {"point": "给出概率和为 1 但有交集的反例", "evidence": ["重叠", "交集", "反例", "p(ab)=0.1"]}], "common_errors": [{"wrong": "就是对立", "desc": "把数值条件当定义，漏掉互斥要求"}]}
{"id": "prob-037", "domain": "probability", "kind": "error_catch", "difficulty": "hard", "topic": "考点：大数定律的收敛含义", "question": "请判断下面说法是否正确，若错误请说明：「大数定律说频率稳定于概率，所以掷均匀硬币 1000 次，正面次数恰好是 500 次。」", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。大数定律说的是频率依概率收敛于概率（偏差大于任意 ε 的概率趋于 0），不是恰好相等。1000 次掷骰中正面次数服从二项分布 B(1000, 1/2)，恰好 500 次的概率约 0.025，反而很小；典型波动量级是 √(npq)≈16 次。", "key_steps": [{"point": "指出「稳定」是依概率收敛不是恰好相等", "evidence": ["依概率收敛", "接近", "不等于恰好", "趋于"]}, {"point": "给出波动量级（标准差约 16 次）", "evidence": ["波动", "标准差", "√(npq)", "16", "二项"]}, {"point": "指出恰好 500 次概率其实不大（约 0.025）", "evidence": ["0.025", "恰好", "概率不大", "很小"]}], "common_errors": [{"wrong": "恰好500", "desc": "把「频率趋近概率」误读成「频率等于概率」"}]}
{"id": "prob-038", "domain": "probability", "kind": "error_catch", "difficulty": "hard", "topic": "考点：正态和需要独立性", "question": "请判断下面说法是否正确，若错误请给出反例：「X、Y 都服从正态分布，则 X+Y 一定服从正态分布（无需任何额外条件）。」", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。独立性（或联合正态）才是充分条件。反例：X~N(0,1)，取 Y=−X（显然也服从 N(0,1)），但 X+Y≡0 退化为常数，不是正态分布。边缘正态推不出联合正态。", "key_steps": [{"point": "指出需要独立（或联合正态）条件", "evidence": ["独立", "联合正态", "需要条件", "条件不足"]}, {"point": "给出反例 Y=−X 使和退化", "evidence": ["y=−x", "y=-x", "退化", "恒为0", "常数"]}, {"point": "指出边缘正态推不出联合正态", "evidence": ["边缘", "联合", "推不出"]}], "common_errors": [{"wrong": "一定正态", "desc": "把「独立正态可加」漏掉独立性条件"}]}
{"id": "prob-039", "domain": "probability", "kind": "concept", "difficulty": "medium", "topic": "探针：正态分布三中心", "question": "有同学说：「正态分布的均值、中位数、众数一般不相等，因为分布有一条尾巴。」这个说法对吗？请说明。", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。正态分布是对称单峰分布，均值、中位数、众数三者重合于同一个数 μ（都等于分布中心）。「有尾巴」影响的是偏态分布（如指数分布、对数正态），那里三者才分离。", "key_steps": [{"point": "指出正态三者重合（都等于 μ）", "evidence": ["重合", "都等于μ", "同一个数", "三者相等"]}, {"point": "说明分离发生在偏态分布", "evidence": ["偏态", "偏斜", "指数分布", "对数正态"]}], "common_errors": [{"wrong": "一般不相等", "desc": "把偏态分布的性质搬到对称的正态分布"}]}
{"id": "prob-040", "domain": "probability", "kind": "concept", "difficulty": "hard", "topic": "探针：完全相关的含义", "question": "有同学说：「相关系数 ρ=1 说明 X 与 Y 完全相关，也就是 Y 恒等于 X。」这个说法对吗？请说明 ρ=1 到底意味着什么。", "expected_answer": [], "answer_check": {}, "solution_path": "说法错误。ρ=1 意味着存在正的线性关系 Y=aX+b（a>0），即完全正相关，不要求 Y=X。例如 Y=2X+1 的 ρ 也是 1。反之 ρ=−1 对应 a<0。另外 ρ=1 也推不出「X 大 Y 就在绝对意义上大」，只在线性关系内比较。", "key_steps": [{"point": "指出 ρ=1 ⇔ Y=aX+b（a>0）", "evidence": ["y=ax+b", "y=aX+b", "a>0", "线性关系"]}, {"point": "举例 Y=2X+1 也是 ρ=1", "evidence": ["2x+1", "2x＋1", "例子"]}, {"point": "区分 ρ=−1（a<0）", "evidence": ["ρ=−1", "ρ=-1", "a<0", "负相关"]}], "common_errors": [{"wrong": "恒等于x", "desc": "把完全正相关误当成恒等关系"}]}
